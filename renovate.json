{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 10am on monday", "after 3pm on friday"],
  "rangeStrategy": "bump",
  "platform": "gitlab",
  "major": {
    "automerge": false
  },
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "ignoreDeps": ["lodash", "express"]
}
