{
	"name": "fastapi-sample",
	"description": "FastAPI sample",
	"branchVersion": "^1.2.3",
	"branchPattern": "1.2.*",
	"version": "1.2.3",
	"author": "Alban Andrieu <alban.andrieu@free.fr> (http://albandrieu.com)",
	"main": "scripts.js",
	"type": "module",
	"license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "http://www.opensource.org/licenses/MIT"
		}
	],
	"engines": {
		"node": ">=24.11.1",
		"npm": ">=10.8.2",
		"node-gyp": ">=3.0.3"
	},
	"engine-strict": true,
	"browserslist": [
		"last 1 version",
		"> 1%",
		"maintained node versions",
		"not dead"
	],
	"eslintConfig": {
		"parserOptions": {
			"ecmaVersion": 6
		},
		"plugins": [
			"compat"
		],
		"rules": {
			"compat/compat": "warn"
		}
	},
	"stylelint": {
		"plugins": [
			"stylelint-no-unsupported-browser-features"
		],
		"rules": {
			"plugin/no-unsupported-browser-features": true
		},
		"defaultSeverity": "warning"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.44.2",
		"@vercel/analytics": "^1.5.0",
		"cloc": "^2.0.0-cloc",
		"dd-trace": "^5.28.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@commitlint/prompt-cli": "^20.1.0",
		"@datadog/datadog-ci": "^3.18.0",
		"@eslint/js": "^9.34.0",
		"@nuxt/eslint-config": "^0.3.13",
		"@secretlint/secretlint-rule-preset-recommend": "^11.1.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/gitlab": "^13.2.5",
		"@semantic-release/npm": "^12.0.1",
		"@typescript-eslint/parser": "^8.34.0",
		"commitizen": "^4.3.1",
		"commitlint-config-gitmoji": "^2.3.1",
		"conventional-changelog-conventionalcommits": "7.0.2",
		"cz-conventional-changelog": "^3.3.0",
		"cz-emoji-conventional": "^1.2.1",
		"eslint": "^9.36.0",
		"eslint-formatter-gitlab": "^6.0.1",
		"jest": "^27.3.1",
		"jest-junit": "^16.0.0",
		"markdown-toc": "^1.2.0",
		"prettier": "^3.2.4",
		"secretlint": "^9.3.1",
		"semantic-release": "^24.2.5",
		"semantic-release-replace-plugin": "^1.2.7",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.46.1",
		"wrangler": "^4.9.1"
	},
	"scripts": {
		"prettier": "prettier --check --ignore-unknown \"**/*.*\"",
		"prettier-fix": "prettier --write --ignore-unknown \"**/*.*\"",
		"test": "jest --passWithNoTests",
		"lint": "eslint --format gitlab my-app/",
		"lint:fix": "eslint . --fix",
		"commit": "cz",
		"semantic-release": "semantic-release"
	},
	"remarkConfig": {
		"plugins": [
			"remark-preset-lint-recommended"
		]
	},
	"publishConfig": {
		"access": "restricted",
		"@jusmundi-group:registry": "https://gitlab.com/api/v4/projects/46788175/packages/npm/"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-emoji-conventional",
			"useGitmojis": true
		}
	}
}
