{
	"name": "@AlbanAndrieu/fastapi-sample",
	"description": "FastAPI sample",
	"private": false,
	"branchVersion": "^1.2.3",
	"branchPattern": "1.2.*",
	"version": "1.2.3",
	"author": "Alban Andrieu <alban.andrieu@free.fr> (http://dr-alban.com)",
	"main": "scripts.js",
	"type": "module",
	"license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "http://www.opensource.org/licenses/MIT"
		}
	],
	"publishConfig": {
		"registry": "https://gitlab.com/api/v4/projects/60435718/packages/npm/"
	},
	"engines": {
		"node": ">=24.11.1",
		"npm": ">=10.8.2",
		"node-gyp": ">=3.0.3"
	},
	"engine-strict": true,
	"browserslist": [
		"last 1 version",
		"> 1%",
		"maintained node versions",
		"not dead"
	],
	"eslintConfig": {
		"parserOptions": {
			"ecmaVersion": 6
		},
		"plugins": [
			"compat"
		],
		"rules": {
			"compat/compat": "warn"
		}
	},
	"stylelint": {
		"plugins": [
			"stylelint-no-unsupported-browser-features"
		],
		"rules": {
			"plugin/no-unsupported-browser-features": true
		},
		"defaultSeverity": "warning"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^2.0.15",
		"@astrojs/vercel": "^11.0.3",
		"@dotenvx/dotenvx": "^1.44.2",
		"@supabase/supabase-js": "^2.101.1",
		"@vercel/analytics": "^1.5.0",
		"dd-trace": "^5.100.0",
		"mcp-remote": "^0.1.38",
		"vercel": "^58.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@commitlint/cz-commitlint": "^20.3.1",
		"@commitlint/prompt-cli": "^20.4.1",
		"@datadog/datadog-ci": "^5.0.0",
		"@eslint/js": "^9.34.0",
		"@githubnext/github-copilot-cli": "^0.1.22",
		"@nuxt/eslint-config": "^0.3.13",
		"@secretlint/secretlint-rule-preset-recommend": "^11.1.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/gitlab": "^13.2.5",
		"@semantic-release/npm": "^13.1.3",
		"@typescript-eslint/parser": "^8.34.0",
		"biome": "^0.3.3",
		"cloc": "^2.0.0-cloc",
		"commitizen": "^4.2.4",
		"commitlint": "^20.3.1",
		"commitlint-config-gitmoji": "^2.3.1",
		"conventional-changelog-gitmoji-config": "^1.5.2",
		"cz-conventional-changelog": "^3.3.0",
		"cz-emoji-conventional": "^1.0.1",
		"eslint": "^9.36.0",
		"eslint-formatter-gitlab": "^6.0.1",
		"globals": "^17.7.0",
		"jest": "^27.3.1",
		"jest-junit": "^16.0.0",
		"lodash-es": "^4.17.23",
		"markdown-toc": "^1.2.0",
		"opencommit": "^3.2.14",
		"prettier": "^3.2.4",
		"prisma": "^6.19.3",
		"secretlint": "^9.3.1",
		"semantic-release": "^25.0.2",
		"semantic-release-replace-plugin": "^1.2.7",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.46.1",
		"wrangler": "^4.125.0"
	},
	"scripts": {
		"prettier": "prettier --check --ignore-unknown \"**/*.*\"",
		"prettier-fix": "prettier --write --ignore-unknown \"**/*.*\"",
		"test": "jest --passWithNoTests",
		"lint": "eslint --format gitlab my-app/",
		"lint:fix": "eslint . --fix",
		"commit": "git-cz",
		"semantic-release": "semantic-release",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"oco": "node scripts/run-opencommit.mjs",
		"opencommit": "node scripts/run-opencommit.mjs"
	},
	"files": [
		"scripts/run-opencommit.mjs",
		"scripts.js"
	],
	"remarkConfig": {
		"plugins": [
			"remark-preset-lint-recommended"
		]
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint",
			"useGitmojis": true
		}
	},
	"overrides": {
		"@tootallnate/once": "^3.0.1",
		"@eslint/eslintrc": {
			"ajv": "^6.12.6"
		},
		"eslint": {
			"ajv": "^6.12.6"
		},
		"ajv": "^8.18.0",
		"brace-expansion": "^5.0.5",
		"devalue": "^5.6.4",
		"h3": "^1.15.9",
		"minimatch": "^10.2.3",
		"picomatch": "^4.0.4",
		"smol-toml": "^1.6.1",
