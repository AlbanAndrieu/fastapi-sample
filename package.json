		"undici": "^7.24.0",
		"yaml": "^2.8.3",
		"path-to-regexp": "^8.4.0",
		"express": {
			"path-to-regexp": "0.1.13"
		},
		"mcp-remote": {
			"path-to-regexp": "^6.3.0"
		}
	}
}
