{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ]",
  "redirects": [{ "source": "/", "destination": "/api" }],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://fastapi-sample.fastapicloud.dev/:path*"
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
