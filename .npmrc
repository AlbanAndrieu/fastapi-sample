
# Set URL for your scoped packages.
# For example package with name `@nabla-group/my-package` will use this URL for download
@AlbanAndrieu:registry=https://gitlab.com/api/v4/projects/60435718/packages/npm/
# @nabla-group:registry=https://gitlab.com/api/v4/projects/60435718/packages/npm/

# Add the token for the scoped packages URL. This will allow you to download
# `@nabla-group/` packages from private projects.
//gitlab.com/api/v4/projects/60435718/packages/npm/:_authToken=${NPM_TOKEN}
always-auth=true

# Add token for uploading to the registry. Replace 60435718
# with the project you want your package to be uploaded to.
# '//gitlab.com/api/v4/projects/46788175/packages/npm/:_authToken'="${CI_JOB_TOKEN}"
# prefer-offline=true
