export INFLUXDB_TOKEN="XXX"
export EXPOSE_PORT=8091

export FASTAPI_ENV="development"

export DD_URL="http://defectdojo.service.gra.uat.consul"
export DD_PRODUCT_TYPE_NAME="Showcase"
export DD_PRODUCT_NAME="DefectDojo Importer"
export DD_ENGAGEMENT_NAME="Albandrieu"
export DD_TEST_NAME="Trivy"
export DD_TEST_TYPE_NAME="Trivy Scan"
export DD_FILE_NAME="trivy.json"
export DD_SSL_VERIFY=False
# See  .env.secrets
# DD_API_KEY='XXX'
# secretlint-disable @secretlint/secretlint-rule-basicauth
