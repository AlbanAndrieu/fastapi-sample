{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s %(levelname)s [%(name)s] [%(filename)s:%(lineno)d] [trace_id=%(otelTraceID)s span_id=%(otelSpanID)s resource.service.name=%(otelServiceName)s] - %(message)s"
    },
    "minimal": {
      "format": "%(levelname)s %(message)s"
    },
    "json_request": {
      "": "nabla.utils.log_config.JsonRequestFormatter"
    },
    "json_error": {
     "()": "nabla.utils.log_config.JsonErrorFormatter"
    }
  },
  "handlers": {
    "console": {
      "level": "INFO",
      "class": "logging.StreamHandler",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    },
    "uvicorn": {
      "level": "INFO",
      "class": "logging.StreamHandler",
      "formatter": "minimal",
      "stream": "ext://sys.stdout"
    },
    "json_request": {
      "level": "INFO",
      "class": "logging.StreamHandler",
      "formatter": "json_request",
      "stream": "ext://sys.stdout"
    },
    "json_error": {
        "level": "INFO",
        "class": "logging.StreamHandler",
        "formatter": "json_error",
        "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "handlers": [
      "console"
    ],
    "level": "INFO"
  },
  "loggers": {
    "": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "uvicorn"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [
        "uvicorn"
      ],
      "level": "INFO",
      "propagate": false
    },
    "gunicorn.access": {
      "level": "INFO",
      "handlers": ["json_request"],
      "propagate": false
  },
    "gunicorn.error": {
        "level": "INFO",
        "handlers": ["json_error"],
        "propagate": false
    }
  }
}
