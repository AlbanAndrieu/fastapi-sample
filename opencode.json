{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".github/instructions/*.instructions.md",
    ".github/instructions/memory.instruction.md"
  ],
  "mcp": {
    "fastapi-sample": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "--read-only",
        "--toolsets=context,repos,pull_requests,issues,actions,code_security"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "sentry": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sentry/mcp-server@latest",
        "--host=sentry.albandrieu.com",
        "--skills=inspect",
        "--sentry-dsn="
      ],
      "enabled": false
    },
    "pfsense-auditor": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "pfsense-mcp-server==0.5.1",
        "pfsense-mcp-server"
      ],
      "enabled": false
    }
  }
}
